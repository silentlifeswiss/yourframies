# ==============================================================================
# yourframies - Environment Configuration Example
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# Client-Side Public Variables (Vite prefixed)
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME="yourframies"
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# ------------------------------------------------------------------------------
# Serverless / Netlify Function Secrets (NEVER expose to client frontend)
# ------------------------------------------------------------------------------

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/yourframies?sslmode=require

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Logistics: Delhivery One
DELHIVERY_API_TOKEN=YourDelhiveryAPITokenHere
DELHIVERY_CLIENT_NAME=YOURFRAMIES_EXPRESS
DELHIVERY_MODE=staging # staging | production

# Logistics: Shiprocket
SHIPROCKET_EMAIL=shipping@yourframies.com
SHIPROCKET_PASSWORD=YourShiprocketPasswordHere
SHIPROCKET_PICKUP_PINCODE=110001

# Logistics: NimbusPost
NIMBUSPOST_EMAIL=shipping@yourframies.com
NIMBUSPOST_PASSWORD=YourNimbusPasswordHere

# Authentication & Session (JWT)
JWT_SECRET=super-secret-random-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# SMS / OTP Verification (Fast2SMS / MSG91)
SMS_API_KEY=YourSMSGatewayApiKeyHere

# Storage (Cloudinary / AWS S3 / Supabase Storage for customer frame photos)
CLOUDINARY_CLOUD_NAME=yourframies-cloud
CLOUDINARY_API_KEY=YourCloudinaryKeyHere
CLOUDINARY_API_SECRET=YourCloudinarySecretHere
